#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/*
 * WeAct Studio 3.7" GDEY037T03 / UC8253
 *
 * MOSI GPIO11, SCLK GPIO12, CS GPIO10, D/C GPIO9,
 * RESET GPIO46 (gpio1 offset 14), BUSY GPIO3.
 */

/ {
	chosen {
		zephyr,display = &epaper;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};

	mipi_dbi_epd: mipi_dbi_epd {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>; /* GPIO46 */
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		epaper: uc8253@0 {
			compatible = "ultrachip,uc8253";
			reg = <0>;
			mipi-max-frequency = <1000000>;
			mipi-hold-cs;
			busy-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			psr = [1f 0d];
			width = <240>;
			height = <416>;
		};
	};
};

&spi2 {
	pinctrl-0 = <&spi2_epaper_pins>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&pinctrl {
	spi2_epaper_pins: spi2_epaper_pins {
		group1 {
			pinmux = <SPIM2_SCLK_GPIO12>;
		};
		group2 {
			pinmux = <SPIM2_MOSI_GPIO11>;
			output-low;
		};
	};
};

&usb_serial {
	status = "okay";
};
