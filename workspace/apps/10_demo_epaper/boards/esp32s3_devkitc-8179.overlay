#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

// SDA / MOSI GPIO 11
// SCL / SCK GPIO 12
// CS GPIO 10
// D/C GPIO 9
// RES GPIO 46 (GPIO1_14)
// BUSY GPIO 3

// Bindings
// /opt/toolchains/zephyr/dts/bindings/display/ultrachip,uc8179.yaml
//    - imports others
// /opt/toolchains/zephyr/dts/bindings/display/ultrachip,uc81xx-common.yaml
// /opt/toolchains/zephyr/dts/bindings/mipi-dbi/mipi-dbi-spi-device.yaml
// 		/opt/toolchains/zephyr/dts/bindings/mipi-dbi/mipi-dbi-device.yaml
// 				/opt/toolchains/zephyr/dts/bindings/base/base.yaml
//					pm.yaml
// 				/opt/toolchains/zephyr/dts/bindings/base/power.yaml
// /opt/toolchains/zephyr/dts/bindings/display/display-controller.yaml
// DTS
// /opt/toolchains/zephyr/boards/shields/waveshare_epaper/waveshare_epaper_gdew075t7.overlay

/ {
	chosen {
		zephyr,display = &mydisplay;
	};
	
	mipi_dbi_epd {
		// /opt/toolchains/zephyr/dts/bindings/mipi-dbi/zephyr,mipi-dbi-spi.yaml
		compatible = "zephyr,mipi-dbi-spi";
		// duplex
		// mipi-cpol
		// mipi-cpha
		// mipi-hold-cs
		// /opt/toolchains/zephyr/dts/bindings/mipi-dbi/mipi-dbi-device.yaml
		// mipi-mode
		// mipi-max-frequency
		
		spi-dev = <&spi2>;
		dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;   /* GPIO46 */
		#address-cells = <1>;
		#size-cells = <0>;
		
		// https://docs.zephyrproject.org/latest/build/dts/api/bindings/display/ultrachip%2Cuc8179.html
		
		mydisplay: uc8253@0 {
			// /opt/toolchains/zephyr/dts/bindings/display/ultrachip,uc81xx-common.yaml
			compatible = "ultrachip,uc8175";
			mipi-max-frequency = <1000000>;
			reg = <0>;
			busy-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			softstart = [17 17 17 17];
			full {
				pwr = [07 07 3f 3f];
				cdi = <07>;
				tcon = <0x22>;
				// pwr:
				// cdi:
				// tcon:
				// pll:
				// vdcs:
				// lutc:	
				// lutww:
				// lutkw:
				// lutwk:
				// lutkk:
				// lutbd:
			};
			
			// /opt/toolchains/zephyr/dts/bindings/display/display-controller.yaml
			// (in px)
			width = <240>;
			height = <416>;
		};
	};
};

&spi2 {
	pinctrl-0 = <&spi2_epaper_pins>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&pinctrl {
	spi2_epaper_pins: spi2_epaper_pins {
		group1 {
			pinmux = <SPIM2_SCLK_GPIO12>;
		};
		group2 {
			pinmux = <SPIM2_MOSI_GPIO11>;
			output-low;
		};
	};
};
